APP_NAME="HOWSEY"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://howsey.site

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_hostinger_database
DB_USERNAME=your_hostinger_database_user
DB_PASSWORD=your_hostinger_database_password

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=howsey_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@howsey.site
MAIL_PASSWORD=your_hostinger_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@howsey.site
MAIL_FROM_NAME="${APP_NAME}"

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@howsey.site

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_COMPANY_REGISTRATION_FEE=25000

OLLAMA_API_URL=
OLLAMA_MODEL=
